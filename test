    statusCode: 200, body: undefined, headers: {},
    status(c) { r.statusCode = c; return r; },
    setHeader(k, v) { r.headers[k] = v; return r; },
    json(o) { r.body = o; return r; },
    send(o) { r.body = o; return r; },
    end(x) { if (x !== undefined) r.body = x; return r; }
  };
  return r;
